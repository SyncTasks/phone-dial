# ログイン用パスワード（必須）
APP_PASSWORD=
# セッション署名用のランダム文字列（必須・32文字以上）。例: openssl rand -base64 32
AUTH_SECRET=

# Google スプレッドシート（サービスアカウント）
SHEET_ID=1yBlOqa4MIHQGbhlGcfDLKfFPKERUZNXUMD5MD3FxZ9w
SHEET_TAB=久保田
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# JSON鍵の private_key をそのまま（改行は \n のままでOK）
GOOGLE_PRIVATE_KEY=

# 新規タスクをスプシに追加するときの担当者名と発生元
TASK_OWNER_NAME=Kei Kubota
TASK_SOURCE_NAME=タスクボード

# Vercel Marketplace の Neon（Postgres）を繋ぐと自動で入る
DATABASE_URL=
# Vercel Blob を繋ぐと自動で入る（手書きの画像保存）
BLOB_READ_WRITE_TOKEN=

# Google カレンダー（読み取りのみ）。サービスアカウントに共有したカレンダーのID（カレンダーの設定 →「カレンダーの統合」→ カレンダーID。自分のカレンダーならメールアドレス）
# 空なら予定の表示は出ない
GOOGLE_CALENDAR_ID=

# Mac の返事係（worker/worker.sh）が /api/worker/* を呼ぶときの合言葉。32文字以上のランダム文字列
# 例: openssl rand -hex 32 。空なら worker API は使えない
WORKER_TOKEN=

# チーム向け閲覧ページ /team/<TEAM_VIEW_TOKEN> の合言葉。16文字以上のランダム文字列
# 例: openssl rand -hex 16 。空ならページは 404
TEAM_VIEW_TOKEN=

# 1 にするとスプシ・DBなしで架空データのデモとして動く（ローカル確認用）
DEMO=
