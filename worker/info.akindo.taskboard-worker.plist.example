<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  タスクボード「リマに話す」の返事係を1分おきに起動する launchd 設定の見本。
  使うときは README の「Mac の返事係」の手順で ~/Library/LaunchAgents/ にコピーして読み込む。
  /Users/user/dev/kubota-task-board は実際の置き場所に合わせて書き換える。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>info.akindo.taskboard-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/user/dev/kubota-task-board/worker/worker.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/user/Library/Logs/taskboard_worker.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/user/Library/Logs/taskboard_worker.launchd.log</string>
</dict>
</plist>
